# Copia a .env.local y rellena. Vite solo expone variables VITE_*.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
# Worker de Cloudflare que habla con D1 (ver /workers/api.js)
VITE_POSTS_API_URL=https://me-proyecte-api.tu-subdominio.workers.dev
# Base para Cloudflare Pages: siempre '/'. Solo cámbialo a '/Me-proyecto-/'
# si vuelves a GitHub Pages.
VITE_BASE_PATH=/
