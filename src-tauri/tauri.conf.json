{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Novel Studio",
  "version": "0.1.0",
  "identifier": "com.meproyecto.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mi Novela — Estudio de Nodos de Novela Visual",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
